#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define MAC 0
#define WIN 1
#define NUM 2
#define ARROW 3
#define MOUSE 4
#define SCROLL 5
#define BT 6
#define FUNC 7
#define AERO 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <SCROLL>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        bt_layer {
            bindings = <&mo BT>;
            key-positions = <34 37>;
        };

        // ESC: Q + W
        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        // 前タブ: U + I (Ctrl+Shift+Tab)
        tab_prev {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <6 7>;
        };

        // 次タブ: I + O (Ctrl+Tab)
        tab_next {
            bindings = <&kp LC(TAB)>;
            key-positions = <7 8>;
        };

        // 戻る: M + , (Cmd+[)
        back {
            bindings = <&kp LG(LBKT)>;
            key-positions = <30 31>;
        };

        // 進む: , + . (Cmd+])
        forward {
            bindings = <&kp LG(RBKT)>;
            key-positions = <31 32>;
        };
    };

    macros {
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to MAC>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to WIN>;
            label = "BT_WIN";
        };
    };

    behaviors {
        cmd_eisu: cmd_eisu {
            compatible = "zmk,behavior-hold-tap";
            label = "CMD_EISU";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        // hold: Cmd+Shift+5 / tap: Cmd+Shift+4
        ss_ht: ss_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "SS_HT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac
        mac_layer {
            bindings = <
&kp Q      &kp W         &kp E      &kp R           &kp T                                              &kp Y              &kp U  &kp I      &kp O         &kp P
&kp A      &kp S         &kp D      &kp F           &kp G          &kp SEMICOLON  &kp SQT              &kp H              &kp J  &kp K      &kp L  &lt SCROLL MINUS
&kp Z      &kp X         &kp C      &kp V           &kp B          &lt ARROW TAB  &lt FUNC ENTER       &kp N              &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &lt NUM SPACE  &mt LCMD LANG2  &mt RCMD LANG1      &lt AERO BACKSPACE                                  &ss_ht LG(LS(N5)) LG(LS(N4))
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // Layer 1: Windows (MACレイヤーと同じ体験 / Cmd相当=LGUI、英数/かな=無変換/変換)
        win_layer {
            bindings = <
&kp Q      &kp W         &kp E      &kp R           &kp T                                                       &kp Y                  &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D      &kp F           &kp G          &kp SEMICOLON          &kp SQT              &kp H                  &kp J  &kp K      &kp L    &lt SCROLL MINUS
&kp Z      &kp X         &kp C      &kp V           &kp B          &lt ARROW TAB          &lt FUNC ENTER       &kp N                  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &lt NUM SPACE  &mt LGUI INT_MUHENKAN  &mt LGUI INT_HENKAN  &kp BACKSPACE                                       &kp LG(LS(S))
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // Layer 2: NUM (共通)
        num_layer {
            bindings = <
&kp MINUS                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS                                                      &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PERIOD       &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                   &trans           &trans           &trans           &trans           &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        // Layer 3: ARROW (共通)
        arrow_layer {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&kp LEFT_SHIFT  &trans           &trans          &trans           &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans           &trans          &trans           &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        // Layer 4: MOUSE (自動 via zip_temp_layer)
        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans        &trans    &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1     &mkp MB3  &mkp MB2      &kp LC(LA(N))
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LG(LBKT) &trans    &kp LG(RBKT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                       &trans
            >;
        };

        // Layer 5: SCROLL
        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // Layer 6: BT設定 + Mac/Windows切替
        bt_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt_mac  &bt_win  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans   &trans   &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans   &trans   &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                        &bt BT_CLR_ALL
            >;
        };

        // Layer 7: FUNCTION (共通)
        func_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                          &kp F12
            >;
        };

        // Layer 8: AeroSpace (BACKSPACE hold で進入)
        // 左上段=ワークスペース1-5 / 左ホーム=WSへ移動1-5
        // 右ホーム H/J/K/L=フォーカス / 右下段 N/M/,/.=ウィンドウ移動
        // Y=直前WS U=全画面 I=macネイティブ全画面 O=リサイズ P=分割向き / =レイアウト
        aero_layer {
            bindings = <
&kp LA(N1)      &kp LA(N2)      &kp LA(N3)      &kp LA(N4)      &kp LA(N5)                          &kp LA(TAB)  &kp LA(F)      &kp LA(M)      &kp LA(R)      &kp LA(COMMA)
&kp LA(LS(N1))  &kp LA(LS(N2))  &kp LA(LS(N3))  &kp LA(LS(N4))  &kp LA(LS(N5))  &trans      &trans  &kp LA(H)    &kp LA(J)      &kp LA(K)      &kp LA(L)      &trans
&trans          &trans          &trans          &trans          &trans          &trans      &trans  &kp LA(LS(H))  &kp LA(LS(J))  &kp LA(LS(K))  &kp LA(LS(L))  &kp LA(SLASH)
&trans          &trans          &trans          &trans          &trans          &trans      &trans   &trans                                                      &trans
            >;
        };
    };
};
